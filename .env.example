# ==============================================================
# ai-agent-service — configuration template
# Port: 55570 (external) -> 8000 (internal)
# ==============================================================

# === App ===
APP_NAME=ai-agent-service
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/v1

# === Database ===
POSTGRES_HOST=ai-agent-postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_agent_service
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_ECHO=false

# === Redis (chat history cache) ===
REDIS_HOST=ai-agent-redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
HISTORY_TTL_SECONDS=86400
HISTORY_MAX_ITEMS=20

# === LLM provider (OpenRouter by default) ===
LLM_PROVIDER=openrouter
LLM_API_KEY=CHANGE_ME_OPENROUTER_API_KEY
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_DEFAULT_MODEL=openai/gpt-6-luna
LLM_DEFAULT_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_HTTP_REFERER=https://chota.by
LLM_APP_TITLE=Chota

# === Privacy filter proxy (анонимизация ПД перед внешними LLM) ===
# По умолчанию выключено: сервис работает напрямую с OpenRouter как раньше.
PRIVACY_FILTER_ENABLED=false
PRIVACY_FILTER_BASE_URL=http://privacy-filter-service:8000
PRIVACY_FILTER_TIMEOUT_SECONDS=30

# === Encryption (Fernet key для per-agent LLM keys and MCP credentials) ===
# Сгенерировать: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
# MCP credentials encryption writes remain disabled for the compatibility rollout.
# Enable only after every serving image can read versioned envelopes.
MCP_CREDENTIALS_ENCRYPTION_ENABLED=false

# === Internal S2S (вызовы от subscription-service и др.) ===
# Legacy management credential. Do not distribute it to new ownership callers.
INTERNAL_API_TOKEN=CHANGE_ME_SHARED_INTERNAL_TOKEN
# Receiver-first P1a: leave enforcement off until every ownership caller migrates.
# Registry format and exact migration prerequisites: docs/internal-ownership-auth.md
INTERNAL_AI_AUTH_PRINCIPALS=
INTERNAL_OWNERSHIP_AUTH_REQUIRED=false
CHAT_S2S_TOKEN=CHANGE_ME_DEDICATED_CHAT_TOKEN
CHAT_S2S_AUTH_REQUIRED=false

# === Optional unconsumed managed AgentTurn harness (dedicated complete grants) ===
# Empty registry rejects every managed request. Configure only private test/local
# bindings; this source change does not authorize production registration/traffic.
MANAGED_AI_AUTH_PRINCIPALS=
MANAGED_AI_EXECUTION_SECONDS=90
MANAGED_AI_CONTEXT_BYTES=131072
# Optional private Conversation authority for managed Business writes. Configure
# both values together; absent values keep managed Business effects read-only.
BUSINESS_CONVERSATION_URL=
BUSINESS_CONVERSATION_TOKEN=
BUSINESS_CONVERSATION_TIMEOUT_SECONDS=3
# Optional Handoff Telegram cohort. Empty enrollment keeps the feature dark.
# Each item is an exact {owner_id,integration_id,channel,agent_id} scope and
# must also have a matching managed-principal grant with the trusted account UUID.
HANDOFF_AI_ENROLLED_SCOPES=[]
HANDOFF_CONVERSATION_URL=
HANDOFF_LIFECYCLE_TOKEN=
HANDOFF_LIFECYCLE_TIMEOUT_SECONDS=3
# Optional exact-model opt-in. Unset preserves provider defaults; legacy is unchanged.
# Requires direct OpenRouter (privacy proxy does not support this field yet).
# MANAGED_OPENROUTER_DISABLE_REASONING_MODELS=["xiaomi/mimo-v2.5"]

# === Knowledge Base retrieval (временный global feature flag / kill switch) ===
# Per-agent/per-KB управление будет добавлено отдельной фазой.
KNOWLEDGE_BASE_ENABLED=false
KNOWLEDGE_BASE_SERVICE_URL=http://knowledge-base-service:8000
KNOWLEDGE_BASE_TIMEOUT_SECONDS=2.0
KNOWLEDGE_BASE_MAX_CHARS_PER_CHUNK=1000
KNOWLEDGE_BASE_MAX_TOTAL_CONTEXT_CHARS=3000

# === Subscription service integration (новое, для системы подписок) ===
SUBSCRIPTION_SERVICE_URL=http://45.144.55.73:55600
SUBSCRIPTION_CHECK_ENABLED=true

# === Optional: MCP Bitrix24 integration ===
# Указывается, только если используется Bitrix MCP сервер (mcp_clients/servers/bitrix_server.py).
# Формат: https://<portal>.bitrix24.ru/rest/<user-id>/<webhook-token>/
B24_WEBHOOK_URL=

# === Optional: MCP Google Workspace integration ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SCOPES=https://www.googleapis.com/auth/spreadsheets https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/drive.metadata.readonly https://www.googleapis.com/auth/contacts
GOOGLE_TOKEN_STORAGE_MODE=local
ENABLE_GMAIL_SEND=false
ENABLE_DESTRUCTIVE_TOOLS=false
LOG_LEVEL=info
MCP_SERVER_NAME=chota-google-workspace-mcp
# First-party ChotaCRM managed capabilities (disabled until separately rolled out).
BUSINESS_CAPABILITIES_ENABLED=false
BUSINESS_CRM_URL=http://chota-crm-service:8000
BUSINESS_CRM_KEY_ID=
BUSINESS_CRM_PRIVATE_KEY=
BUSINESS_CRM_TIMEOUT_SECONDS=5
BUSINESS_CONFIG_ORIGINS=["https://chota.by","https://agents.chota.by"]
