# База данных
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_agents_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# LLM (deprecated — per-agent encrypted keys are used instead; kept for backward compatibility)
LLM_API_KEY=
LLM_BASE_URL=
LLM_DEFAULT_MODEL=

# Encryption (required — encrypts per-agent OpenRouter API keys)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Internal service-to-service token (required for /internal/* endpoints)
# Must match INTERNAL_API_TOKEN in subscription-service / other callers.
INTERNAL_API_TOKEN=

SUBSCRIPTION_SERVICE_URL=
SUBSCRIPTION_CHECK_ENABLED=
